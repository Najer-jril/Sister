# Copy to .env and adjust values for local development

# Aggregator
DATABASE_URL=postgresql://user:pass@localhost:5432/aggregatordb
REDIS_URL=redis://localhost:6379
NUM_WORKERS=4
LOG_LEVEL=INFO

# Publisher
TARGET_URL=http://localhost:8080/publish
TOTAL_EVENTS=20000
DUPLICATE_RATE=0.30
CONCURRENCY=10
